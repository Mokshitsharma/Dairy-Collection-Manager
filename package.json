{
  "name": "dairy-collection-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "node scripts/emulators.mjs",
    "local-user": "node scripts/local-user.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
