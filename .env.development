# Used by `npm run dev` / `npm start` only: talk to the local Firebase emulators.
# Production builds (Vercel) ignore this file and read the VITE_FIREBASE_* variables
# from the Vercel project settings instead.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-dairy
VITE_FIREBASE_API_KEY=demo-key
